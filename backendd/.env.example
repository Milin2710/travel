# ========================================
# Backend Environment Variables
# ========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For LOCAL development: Use your local MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=travel_db
DB_PORT=3306

# For PRODUCTION (Cloud Database):
# DB_USER=
# DB_PASSWORD=your_aiven_password_here
# DB_NAME=defaultdb
# DB_PORT=17691

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
# For LOCAL development: http://localhost:5173
# For PRODUCTION: Replace with your deployed frontend URL
FRONTEND_URL=http://localhost:5173

# Google OAuth (same Client ID as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary (avatar uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Instructions:
# 1. Copy this file to .env
# 2. Update database credentials for your local MySQL
# 3. Change JWT_SECRET to a strong random string for production
